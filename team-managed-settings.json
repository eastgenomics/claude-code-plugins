{
  "permissions": {
    "allow": ["Bash(gh *)"],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh workflow delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh auth logout:*)"
    ]
  },
  "enabledPlugins": {
    "eastgen-plugin@eastgenomics": true
  },
  "extraKnownMarketplaces": {
    "eastgenomics": {
      "autoUpdate": true,
      "source": {
        "repo": "eastgenomics/claude-code-plugins",
        "source": "github"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh *", "git push *"]
  }
}
